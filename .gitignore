.DS_Store

node_modules/
dist/
out/
.tsbuild/
*.tsbuildinfo

# Telemetry recordings are large and per-machine. The small synthetic fixture the
# tests replay lives in packages/telemetry/test/fixtures/ and IS checked in.
data/recordings/*
!data/recordings/.gitkeep

# data/reference/ is the exception and IS committed: the hand-picked clean laps
# that track maps and reference laps are cut from. A recording is per-machine
# noise, but the one lap a map was built from is the provenance of every corner
# in it — regenerating a map from "some lap I drove that evening" is not a thing
# you can do six months later. Big files, few of them, added deliberately.

# data/demo/ is committed: the Spa turn-1 fixture as real artefacts, so the
# replay CLI and the desktop app have something to run against out of the box.
# Everything below is generated or per-machine.

# Generated artefacts — regenerated from recordings, not source of truth.
#
# corners.override.json is the exception and IS committed. It is hand-written
# source, not output: §5.2's "ten minutes per track" of human judgement about
# which detected regions are really one corner. Regenerating a map is cheap;
# regenerating that is a person watching a lap again. Everything else under
# data/tracks/ falls out of a recording plus the override.
data/tracks/**
!data/tracks/**/
!data/tracks/**/corners.override.json
!data/tracks/.gitkeep
data/reflaps/*
!data/reflaps/.gitkeep
data/audio/*
!data/audio/.gitkeep

# Voices and Piper are fetched, not authored — tens of megabytes of somebody
# else's release artefacts. data/voices/ holds the .onnx models the preferences
# window downloads; data/piper/ the standalone build it installs.
data/voices/*
!data/voices/.gitkeep
data/piper/*
!data/piper/.gitkeep
# yt-dlp, fetched by the YouTube importer the same way.
data/tools/*
# Callouts converted from a video for a track with no map yet, waiting on one.
data/**/imports/
# Which local note sets are published or installed packs (M8): one machine's
# install state, and wrong on any other.
data/**/content/
data/profile/*
!data/profile/.gitkeep

.env
.env.local

# Piper lives in a project-local venv so it stays out of any system Python.
# See README, "Rendering audio".
.venv/

# Voice models are ~60 MB each and are downloaded, not authored.
#
# Anchored to the repo root. Unanchored, this matched `data/voices/` too, and
# being the later rule it beat that section's `!data/voices/.gitkeep` — so the
# folder the app downloads into did not exist on a fresh clone. A top-level
# voices/ is still ignored: the old README told people to make one.
/voices/

# Third-party video transcripts. Ingest input (§10), not our content — §10's
# provenance rule is to record the source, not to redistribute the material.
*transcript*.txt

# Browser libraries copied from node_modules at build time (scripts/vendor.mjs).
apps/desktop/static/vendor/

# Packaged builds (apps/desktop/scripts/package.mjs)
apps/desktop/release/

# Guide videos downloaded by the experimental tracer.
data/video-cache/
