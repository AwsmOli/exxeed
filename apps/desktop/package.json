{
  "name": "@exxeed/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Electron shell. Owns the telemetry loop, the note engine and audio — never a renderer.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "node scripts/vendor.mjs && tsc --build",
    "dev": "node scripts/vendor.mjs && tsc --build && electron .",
    "start": "electron .",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@exxeed/core": "workspace:*",
    "@exxeed/importer": "workspace:*",
    "@exxeed/overlays": "workspace:*",
    "@exxeed/repo": "workspace:*",
    "@exxeed/telemetry": "workspace:*",
    "@exxeed/tts": "workspace:*",
    "dompurify": "^3.4.16",
    "koffi": "^3.3.2",
    "marked": "^18.0.14",
    "monaco-editor": "0.57.0"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  }
}
